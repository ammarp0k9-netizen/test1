            <span>${escapeHtml(def.name)}</span>
          </button>
        `).join('')}
      `;
    }
    
    function getLootState() {
      return loadJSON(LOOT_STATE_KEY, {
        lastOpenAt: 0,
        streak: 0,
        totalOpens: 0,
        lastOpenDay: '',
        rewards: [],
        freezesEarned: 0,
        lockedXP: 0,
        lockStartedAt: 0,
        lockResolvedAt: 0,
        lockMasteredWordIds: [],
        lockHighAccuracyQuizIds: []
