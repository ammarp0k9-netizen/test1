  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    rules_version = '2';
    
    // Operational, low-complexity ruleset for isolating Rules compiler failures.
    // It intentionally keeps authority boundaries (public published content, owner
    // data, and claim-based admins) while omitting production's deep game-state
    // and cross-document invariant validators.  It is not a replacement for the
    // production ruleset.
    service cloud.firestore {
      match /databases/{database}/documents {
        function signedIn() {
          return request.auth != null;
        }
    
        function isOwner(uid) {
          return signedIn() && request.auth.uid == uid;
        }
    
        function isAdmin() {
          return signedIn() &&
            'admin' in request.auth.token && request.auth.token.admin == true;
        }
    
        function nonEmptyString(value, maxLength) {
          return value is string && value.size() > 0 && value.size() <= maxLength;
        }
    
        function publishedWorld(worldId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)).data.status == 'published';
        }
    
        function publishedRank(worldId, rankId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)).data.status == 'published';
        }
    
        function publishedGate(worldId, rankId, gateId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)).data.status == 'published';
        }
    
        // Prepared learning content. Browser administration remains claim-gated;
        // public reads retain the production requirement for published ancestry.
        match /content_worlds/{worldId} {
          function validContentStatus(status) {
            return status == 'draft' || status == 'published' || status == 'archived';
          }
    
          function validWorldShape(data) {
            return data.worldId == worldId && validContentStatus(data.status) &&
              (!('title' in data) || nonEmptyString(data.title, 160)) &&
              (!('schemaVersion' in data) || data.schemaVersion == 1) &&
              (!('version' in data) || (data.version is int && data.version >= 0));
          }
    
          allow read: if isAdmin() || resource.data.status == 'published';
          allow create, update: if isAdmin() && validWorldShape(request.resource.data);
          allow delete: if isAdmin();
    
          match /ranks/{rankId} {
            function validRankShape(data) {
              return data.worldId == worldId && data.rankId == rankId &&
                validContentStatus(data.status) &&
                (!('title' in data) || nonEmptyString(data.title, 160)) &&
                (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                (!('version' in data) || (data.version is int && data.version >= 1));
            }
    
            allow read: if isAdmin() ||
              (resource.data.status == 'published' && publishedWorld(worldId));
            allow create, update: if isAdmin() && validRankShape(request.resource.data);
            allow delete: if isAdmin();
    
            match /gates/{gateId} {
              function validGateShape(data) {
                return data.worldId == worldId && data.rankId == rankId && data.gateId == gateId &&
                  validContentStatus(data.status) &&
                  (!('title' in data) || nonEmptyString(data.title, 160)) &&
                  (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                  (!('version' in data) || (data.version is int && data.version >= 1));
              }
    
              allow read: if isAdmin() ||
                (resource.data.status == 'published' && publishedWorld(worldId) &&
                  publishedRank(worldId, rankId));
              allow create, update: if isAdmin() && validGateShape(request.resource.data);
              allow delete: if isAdmin();
    
              match /words/{contentWordId} {
                function validContentWordShape(data) {
                  return data.worldId == worldId && data.rankId == rankId &&
                    data.gateId == gateId && data.contentWordId == contentWordId &&
                    validContentStatus(data.status) &&
                    nonEmptyString(data.word, 240) &&
                    nonEmptyString(data.translation, 1000) &&
                    (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                    (!('version' in data) || (data.version is int && data.version >= 1));
                }
    
                allow read: if isAdmin() ||
                  (resource.data.status == 'published' && publishedWorld(worldId) &&
                    publishedRank(worldId, rankId) && publishedGate(worldId, rankId, gateId));
                allow create, update: if isAdmin() && validContentWordShape(request.resource.data);
                allow delete: if isAdmin();
              }
            }
          }
        }
    
        match /content_word_import_staging/{stagingWordId} {
          allow read, create, update, delete: if isAdmin();
        }
    
        // These are server/Admin-SDK workflows. Client access remains denied.
        // Feedback v2 is an append-only client submission, not trusted learning metadata.
        // Both guests and signed-in users may submit; only admins can read responses.
        match /feedback/{feedbackId} {
          function validClientFeedback(data) {
            return data.keys().hasOnly([
                'schemaVersion', 'rating', 'message', 'optionalName', 'ownerId', 'submittedAt'
              ]) && data.keys().hasAll([
                'schemaVersion', 'rating', 'message', 'optionalName', 'ownerId', 'submittedAt'
              ]) && data.schemaVersion == 2 &&
              data.rating is int && data.rating >= 1 && data.rating <= 5 &&
              data.message is string && data.message.size() <= 1600 &&
              data.optionalName is string && data.optionalName.size() <= 80 &&
              data.ownerId is string &&
              ((request.auth == null && data.ownerId == 'guest') ||
                (request.auth != null && data.ownerId == request.auth.uid)) &&
              data.submittedAt == request.time;
          }
          allow create: if feedbackId.matches('[A-Za-z0-9]{20}') &&
            validClientFeedback(request.resource.data);
          allow read: if isAdmin();
          allow update, delete: if false;
        }
        match /admin_audit_logs/{logId} { allow read: if isAdmin(); allow write: if false; }
        match /admins/{adminId} { allow read, write: if false; }
    
        match /users/{uid} {
          // No root-document list/write access; all application data is explicit.
          allow get: if isOwner(uid);
          allow list, create, update, delete: if false;
    
          // Personal dictionary and custom worlds are owner-scoped. These docs do
          // not confer admin authority or access to another account.
          match /words/{wordId} {
            function validPersonalWord(data) {
              return data.userId == uid && data.meaning is string && data.meaning.size() <= 2000 &&
                data.category is string && data.category.size() <= 120 &&
                (('text' in data && nonEmptyString(data.text, 500)) ||
                  ('word' in data && nonEmptyString(data.word, 500))) &&
                (!('forgetCount' in data) || (data.forgetCount is int && data.forgetCount >= 0)) &&
                (!('starred' in data) || data.starred is bool);
            }
            allow read, delete: if isOwner(uid);
            allow create, update: if isOwner(uid) && validPersonalWord(request.resource.data);
          }
          match /customWorlds/{worldId} {
            function validCustomWorld(data) {
              return data.userId == uid && nonEmptyString(data.name, 240) &&
                (!('description' in data) || (data.description is string && data.description.size() <= 4000));
            }
            allow read, delete: if isOwner(uid);
            allow create, update: if isOwner(uid) && validCustomWorld(request.resource.data);
            match /words/{wordId} {
              function validCustomWorldWord(data) {
                return data.userId == uid && data.meaning is string && data.meaning.size() <= 2000 &&
                  data.category is string && data.category.size() <= 120 &&
                  (('text' in data && nonEmptyString(data.text, 500)) ||
                    ('word' in data && nonEmptyString(data.word, 500)));
              }
              allow read, delete: if isOwner(uid);
              allow create, update: if isOwner(uid) && validCustomWorldWord(request.resource.data);
            }
          }
    
          // User settings, onboarding, XP metadata, and local quiz state.
          match /meta/profile {
            function validProfile(data) {
              return (!('userXP' in data) || (data.userXP is number && data.userXP >= 0)) &&
                (!('xpEconomyVersion' in data) ||
                  (data.xpEconomyVersion is int && data.xpEconomyVersion >= 0)) &&
                (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0)) &&
                (!('maxStreak' in data) || (data.maxStreak is int && data.maxStreak >= 0)) &&
                (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
            }
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid) && validProfile(request.resource.data);
            allow delete: if false;
          }
          match /meta/word_mastery { allow read, create, update: if isOwner(uid); allow delete: if false; }
          match /meta/active_quiz_session { allow read, create, update, delete: if isOwner(uid); }
          match /meta/active_content_journey { allow read, create, update: if isOwner(uid); allow delete: if false; }
          match /meta/{metaId} {
            allow read: if isOwner(uid) && metaId.matches('xp_event_.*');
            allow create: if isOwner(uid) && metaId.matches('xp_event_.*');
            allow update, delete: if false;
          }
    
          match /guidedFirstJourneys/{versionId} {
            function validGuidedJourney(data) {
              return data.version == 1 && data.audience == 'new' &&
                data.phase in [
                  'awaiting-first-gate', 'first-gate-opened',
                  'awaiting-quiz-cta', 'completed'
                ] && nonEmptyString(data.worldId, 128) &&
                data.guestDictionaryAvailable is bool && data.startedAt is timestamp &&
                data.updatedAt is timestamp &&
                ((data.phase == 'completed' && data.completedAt is timestamp) ||
                  (data.phase != 'completed' && data.completedAt == null));
            }
            allow read: if isOwner(uid);
            allow create: if isOwner(uid) && versionId == 'v1' &&
              validGuidedJourney(request.resource.data);
            allow update: if isOwner(uid) && versionId == 'v1' &&
              validGuidedJourney(request.resource.data) &&
              request.resource.data.version == resource.data.version &&
              request.resource.data.audience == resource.data.audience &&
              request.resource.data.worldId == resource.data.worldId &&
              request.resource.data.startedAt == resource.data.startedAt &&
              (resource.data.guestDictionaryAvailable == false ||
                request.resource.data.guestDictionaryAvailable == true) &&
              (
                (resource.data.phase == 'awaiting-first-gate' &&
                  request.resource.data.phase in ['awaiting-first-gate', 'first-gate-opened']) ||
                (resource.data.phase == 'first-gate-opened' &&
                  request.resource.data.phase in ['first-gate-opened', 'awaiting-quiz-cta']) ||
                (resource.data.phase == 'awaiting-quiz-cta' &&
                  request.resource.data.phase in ['awaiting-quiz-cta', 'completed'])
              );
            allow delete: if false;
          }
          match /entryExperiences/{versionId} {
            allow read, create, update: if isOwner(uid) && versionId.matches('v[0-9]+');
            allow delete: if false;
          }
    
          match /notifications/{notificationId} {
            function validNotification(data) {
              return data.ownerId == uid && data.id == notificationId &&
                data.status in ['pending', 'active', 'resolved', 'dismissed'] &&
                data.message is string && data.message.size() <= 4000 &&
                (!('priority' in data) || (data.priority is int && data.priority >= 0 && data.priority <= 100));
            }
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid) && validNotification(request.resource.data);
            allow delete: if false;
          }
    
          match /testSettings/clock {
            allow read, create, update: if isOwner(uid) && isAdmin() &&
              'testClock' in request.auth.token && request.auth.token.testClock == true;
            allow delete: if false;
          }
    
          // Journey, placement, level-placement, and gate-clear documents are
          // owner-scoped with stable path identities and basic state shapes. The
          // production ruleset adds the remaining cross-document/batch invariants.
          match /contentProgress/{worldId} {
            function validJourney(data) {
              return data.worldId == worldId && data.journeyVersion == 1 &&
                data.status in ['active', 'paused'] &&
                nonEmptyString(data.activeRankId, 128) && nonEmptyString(data.activeGateId, 128) &&
                data.startedAt is timestamp && data.updatedAt is timestamp &&
                data.placementStatus in ['not-started', 'active', 'completed', 'declined'] &&
                (!('activePlacementAssessmentId' in data) ||
                  (data.activePlacementAssessmentId is string && data.activePlacementAssessmentId.size() <= 500)) &&
                (!('activeLevelPlacementAssessmentId' in data) ||
                  (data.activeLevelPlacementAssessmentId is string && data.activeLevelPlacementAssessmentId.size() <= 500));
            }
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid) && validJourney(request.resource.data);
            allow delete: if false;
            match /placementSessions/{assessmentId} {
