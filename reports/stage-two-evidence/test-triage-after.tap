                  after.diff(before).affectedKeys().hasOnly([
                    'answers', 'currentQuestionIndex', 'correctCount', 'status', 'updatedAt'
                  ]) &&
                  after.answers.size() == before.answers.size() + 1 &&
                  after.currentQuestionIndex == before.currentQuestionIndex + 1 &&
                  after.currentQuestionIndex == after.answers.size() &&
                  after.currentQuestionIndex <= after.totalCount &&
                  validGateClearAnswer(
                    after.answers[before.answers.size()],
                    before.questionOrder[before.currentQuestionIndex],
                    before.questionOrder
                  ) &&
                  after.correctCount == before.correctCount +
                    (after.answers[before.answers.size()].correct ? 1 : 0) &&
                  after.updatedAt == request.time &&
                  (
                    (after.currentQuestionIndex < after.totalCount && after.status == 'active') ||
                    (after.currentQuestionIndex == after.totalCount && after.status == 'submitting')
                  );
              }
    
              function validGateClearAttemptFinish(before, after) {
                return validGateClearAttempt(after) &&
                  before.status == 'submitting' &&
                  after.diff(before).affectedKeys().hasOnly([
                    'status', 'result', 'score', 'completedAt', 'updatedAt'
                  ]) &&
                  before.currentQuestionIndex == before.totalCount &&
                  before.answers.size() == before.totalCount &&
                  after.score == after.correctCount / after.totalCount &&
                  after.completedAt == request.time && after.updatedAt == request.time &&
                  (
                    (before.correctCount >= before.requiredCorrect &&
                      after.status == 'passed' && after.result == 'passed') ||
                    (before.correctCount < before.requiredCorrect &&
                      after.status == 'failed' && after.result == 'failed')
                  );
              }
    
              function validGateClearAttemptAbandon(before, after) {
                return validGateClearAttempt(after) &&
                  before.status == 'active' &&
                  after.diff(before).affectedKeys().hasOnly([
