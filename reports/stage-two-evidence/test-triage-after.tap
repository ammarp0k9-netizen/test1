    rules_version = '2';
    
    // Operational, low-complexity ruleset for isolating Rules compiler failures.
    // It intentionally keeps authority boundaries (public published content, owner
    // data, and claim-based admins) while omitting production's deep game-state
    // and cross-document invariant validators.  It is not a replacement for the
    // production ruleset.
    service cloud.firestore {
      match /databases/{database}/documents {
        function signedIn() {
          return request.auth != null;
        }
    
        function isOwner(uid) {
          return signedIn() && request.auth.uid == uid;
        }
    
        function isAdmin() {
          return signedIn() &&
            'admin' in request.auth.token && request.auth.token.admin == true;
        }
    
        function nonEmptyString(value, maxLength) {
          return value is string && value.size() > 0 && value.size() <= maxLength;
        }
    
        function publishedWorld(worldId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)).data.status == 'published';
        }
    
        function publishedRank(worldId, rankId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)).data.status == 'published';
        }
    
        function publishedGate(worldId, rankId, gateId) {
          return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)) &&
            get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)).data.status == 'published';
        }
    
        // Prepared learning content. Browser administration remains claim-gated;
        // public reads retain the production requirement for published ancestry.
        match /content_worlds/{worldId} {
          function validContentStatus(status) {
            return status == 'draft' || status == 'published' || status == 'archived';
          }
    
          function validWorldShape(data) {
            return data.worldId == worldId && validContentStatus(data.status) &&
              (!('title' in data) || nonEmptyString(data.title, 160)) &&
              (!('schemaVersion' in data) || data.schemaVersion == 1) &&
              (!('version' in data) || (data.version is int && data.version >= 0));
          }
    
          allow read: if isAdmin() || resource.data.status == 'published';
          allow create, update: if isAdmin() && validWorldShape(request.resource.data);
          allow delete: if isAdmin();
    
          match /ranks/{rankId} {
            function validRankShape(data) {
              return data.worldId == worldId && data.rankId == rankId &&
                validContentStatus(data.status) &&
                (!('title' in data) || nonEmptyString(data.title, 160)) &&
                (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                (!('version' in data) || (data.version is int && data.version >= 1));
            }
    
            allow read: if isAdmin() ||
              (resource.data.status == 'published' && publishedWorld(worldId));
            allow create, update: if isAdmin() && validRankShape(request.resource.data);
            allow delete: if isAdmin();
    
            match /gates/{gateId} {
              function validGateShape(data) {
                return data.worldId == worldId && data.rankId == rankId && data.gateId == gateId &&
                  validContentStatus(data.status) &&
                  (!('title' in data) || nonEmptyString(data.title, 160)) &&
                  (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                  (!('version' in data) || (data.version is int && data.version >= 1));
              }
    
              allow read: if isAdmin() ||
                (resource.data.status == 'published' && publishedWorld(worldId) &&
                  publishedRank(worldId, rankId));
              allow create, update: if isAdmin() && validGateShape(request.resource.data);
              allow delete: if isAdmin();
    
              match /words/{contentWordId} {
                function validContentWordShape(data) {
                  return data.worldId == worldId && data.rankId == rankId &&
                    data.gateId == gateId && data.contentWordId == contentWordId &&
                    validContentStatus(data.status) &&
                    nonEmptyString(data.word, 240) &&
                    nonEmptyString(data.translation, 1000) &&
                    (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                    (!('version' in data) || (data.version is int && data.version >= 1));
                }
    
                allow read: if isAdmin() ||
                  (resource.data.status == 'published' && publishedWorld(worldId) &&
