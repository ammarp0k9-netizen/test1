            let session = get(/databases/$(database)/documents/users/$(uid)/quizEvidenceSessions/$(id)).data;
            let previous = before.get('runnerReviewCompletedSessionId', '');
            return session.officialReviewWorldId == worldId && session.officialReviewRankId == rankId &&
              session.officialReviewGateId == gateId && after.runnerReviewCompletedDueWordKeys == session.officialReviewDueWordKeys &&
              after.loadedWordKeys.hasAll(after.runnerReviewCompletedDueWordKeys) && session.completedAt >= before.loadedAt &&
              (previous == '' || session.completedAt > get(/databases/$(database)/documents/users/$(uid)/quizEvidenceSessions/$(previous)).data.completedAt);
          }
          function validLevelPlacementGate(id) {
