        allow delete: if false;
      }
      match /entryExperiences/{versionId} {
        allow get: if isOwner(uid) && versionId in ['v1', 'v2'];
        allow create: if isOwner(uid) && request.resource.data.status != 'skipped' &&
          (validEntryExperience(request.resource.data, versionId) || validEntryExperienceV2(request.resource.data, versionId));
        allow update: if isOwner(uid) && (validEntryExperienceUpdate(resource.data, request.resource.data, versionId) ||
          validEntryExperienceV2Update(resource.data, request.resource.data, versionId));
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        function validNotification(data) {
          return data.ownerId == uid && data.id == notificationId &&
            data.status in ['pending', 'active', 'resolved', 'dismissed'] &&
            data.message is string && data.message.size() <= 4000 &&
