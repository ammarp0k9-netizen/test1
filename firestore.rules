rules_version = '2';

// Operational Spark rules with bounded per-word checks.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasPermanentAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return hasPermanentAccount() &&
        'admin' in request.auth.token && request.auth.token.admin == true;
    }

    // One owner-only import is open at a time. The permit can only be
    // created from an anonymous identity's immutable grant to this account.
    function savedGuestPermit(uid) {
      return /databases/$(database)/documents/users/$(uid)/meta/saved_guest_import;
    }
    function savedGuestReceipt(uid, sourceUid) {
      return /databases/$(database)/documents/users/$(uid)/guestProgressImports/$(sourceUid);
    }
    function importingSavedGuest(uid) {
      return request.resource.data.get('_savedGuestImportedAt', null) == request.time &&
        isOwner(uid) && hasPermanentAccount() && exists(savedGuestPermit(uid));
    }

    function nonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function publishedWorld(worldId) {
      return exists(/databases/$(database)/documents/content_worlds/$(worldId)) &&
        get(/databases/$(database)/documents/content_worlds/$(worldId)).data.status == 'published';
    }

    function publishedRank(worldId, rankId) {
      return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)) &&
        get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)).data.status == 'published';
    }

    function publishedGate(worldId, rankId, gateId) {
      return exists(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)) &&
        get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)).data.status == 'published';
    }

    function gateContentPath(worldId, rankId, gateId) {
      return /databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId);
    }

    function ownerGatePath(uid, worldId, rankId, gateId) {
      return /databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/ranks/$(rankId)/gates/$(gateId);
    }

    function completeGateProof(uid, gate, worldId, rankId, gateId, passRatio) {
      let proof = get(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/ranks/$(rankId)/gates/$(gateId)/readiness/proof).data;
      let content = get(gateContentPath(worldId, rankId, gateId)).data;
      let loaded = gate.get('loadedContentWordIds', []);
      let published = content.get('publishedWordIds', loaded);
      let ratio = content.get('passThreshold', content.get('entryAssessmentPassRatio', content.get('unlockConfig', {}).get('passThreshold', 0.75)));
      return content.status == 'published' && loaded.size() > 0 && loaded.toSet().size() == loaded.size() &&
        published.toSet() == loaded.toSet() && proof.wordIds.hasAll(loaded) &&
        (passRatio == null || passRatio == (ratio is number && ratio > 0 && ratio <= 1 ? ratio : 0.75));
    }

    function validProofWord(uid, worldId, rankId, gateId, id) {
      let word = get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)/words/$(id)).data;
      let key = word.wordKey;
      let canonical = get(/databases/$(database)/documents/users/$(uid)/contentWords/$(key)).data;
      let lastId = canonical.lastEvidenceEventId;
      let last = get(/databases/$(database)/documents/users/$(uid)/contentWords/$(key)/evidence/$(lastId)).data;
      return word.status == 'published' && canonical.wordKey == key && canonical.eligibleEvidenceCount == 3 &&
        last.sequence == 3 && last.wordKey == key && last.occurredAt == canonical.lastEligibleEvidenceAt;
    }

    function validProofAppend(data, prior, uid, worldId, rankId, gateId) {
      return data.keys().hasOnly(['wordIds', 'addedWordId']) &&
        nonEmptyString(data.addedWordId, 128) && !(data.addedWordId in prior) &&
        prior.size() < 2000 && data.wordIds == prior.concat([data.addedWordId]) &&
        validProofWord(uid, worldId, rankId, gateId, data.addedWordId);
    }

    function sameLoadedWords(before, after) {
      return after.get('loadedContentWordIds', []) == before.get('loadedContentWordIds', []) &&
        after.get('loadedWordKeys', []) == before.get('loadedWordKeys', []) &&
        after.get('loadedAt', null) == before.get('loadedAt', null);
    }

    function sameLoadedGate(before, after) {
      return sameLoadedWords(before, after) && after.get('nextRankId', '') == before.get('nextRankId', '') &&
        after.get('nextGateId', '') == before.get('nextGateId', '');
    }

    function passedActiveAttempt(before, after, uid, worldId, rankId, gateId) {
      let id = before.get('activeClearAttemptId', '');
      return nonEmptyString(id, 500) && after.lastClearAttemptId == id && after.get('activeClearAttemptId', '') == '' &&
        after.clearedAt == request.time && after.lastClearResult == 'passed' &&
        passedAttemptRow(uid, worldId, rankId, gateId, id, after);
    }

    function passedAttemptRow(uid, worldId, rankId, gateId, id, after) {
      let attempt = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/gateClearAttempts/$(id)).data;
      return attempt.status == 'passed' && attempt.completedAt == request.time &&
        attempt.rankId == rankId && attempt.gateId == gateId &&
        attempt.correctCount == after.clearCorrect && attempt.totalCount == after.clearTotal && attempt.score == after.clearScore;
    }

    function normalProgressAdvance(before, after, uid, worldId) {
      let oldGate = getAfter(ownerGatePath(uid, worldId, before.activeRankId, before.activeGateId)).data;
      return oldGate.status == 'cleared' && oldGate.clearedAt == request.time &&
        oldGate.clearedBy == 'gate-clear' && oldGate.nextGateId == after.activeGateId &&
        oldGate.nextRankId == after.activeRankId && publishedGate(worldId, after.activeRankId, after.activeGateId) &&
        after.unlockedGateIds.toSet() == before.unlockedGateIds.toSet().union([after.activeGateId].toSet()) &&
        after.unlockedRankIds.toSet() == before.unlockedRankIds.toSet().union([after.activeRankId].toSet());
    }

    function validEvidenceMode(mode) {
      return mode in ['timeAttack', 'scramble', 'matching'];
    }

    function validOfficialReview(data, uid) {
      let world = data.get('officialReviewWorldId', '');
      let rank = data.get('officialReviewRankId', '');
      let gate = data.get('officialReviewGateId', '');
      let due = data.get('officialReviewDueWordKeys', []);
      return (world == '' && rank == '' && gate == '' && due == []) ||
        (nonEmptyString(world, 128) && nonEmptyString(rank, 128) && nonEmptyString(gate, 128) &&
          due is list && due.size() > 0 && due.toSet().size() == due.size() &&
          data.sourceType == 'personal' && data.wordKeys.hasAll(due) &&
          loadedReviewCohort(data, uid, world, rank, gate));
    }

    function loadedReviewCohort(data, uid, world, rank, gate) {
      let progress = get(ownerGatePath(uid, world, rank, gate)).data;
      return progress.status in ['learning', 'ready'] && progress.loadedAt is timestamp &&
        progress.loadedWordKeys.hasAll(data.wordKeys);
    }

    function validEvidenceSession(data, uid, id) {
      return data.keys().hasOnly(['sessionId', 'status', 'mode', 'sourceType', 'privateWorldId',
          'wordKeys', 'correctWordKeys', 'totalCount', 'correctCount', 'evidenceVersion', 'completedAt',
          'officialReviewWorldId', 'officialReviewRankId', 'officialReviewGateId', 'officialReviewDueWordKeys']) &&
        data.sessionId == id && nonEmptyString(id, 220) && data.status == 'completed' && validEvidenceMode(data.mode) &&
        data.sourceType in ['personal', 'private-world'] && data.privateWorldId is string && data.privateWorldId.size() <= 500 &&
        (data.sourceType == 'personal' ? data.privateWorldId == '' : data.privateWorldId != '') &&
        data.wordKeys is list && data.wordKeys.size() > 0 && data.wordKeys.size() <= 2000 &&
        data.wordKeys.toSet().size() == data.totalCount && data.wordKeys.size() == data.totalCount &&
        data.correctWordKeys is list && data.correctWordKeys.size() == data.correctCount &&
        data.correctWordKeys.toSet().size() == data.correctCount && data.wordKeys.hasAll(data.correctWordKeys) &&
        data.evidenceVersion == 2 && data.completedAt == request.time && validOfficialReview(data, uid);
    }

    function recallDay(time, offset) {
      return int((time.toMillis() - offset * 60000) / 86400000);
    }

    function eligibleEvidenceTime(before, event) {
      let count = before.get('eligibleEvidenceCount', 0);
      let last = before.get('lastEligibleEvidenceAt', null);
      let offset = event.timezoneOffsetMinutes;
      return offset is int && offset >= -840 && offset <= 840 &&
        offset == before.get('evidenceTimezoneOffsetMinutes', offset) &&
        event.localDayKey is int && event.localDayKey == recallDay(request.time, offset) &&
        (count == 0 ||
          (count == 1 && last <= request.time - duration.value(2, 'h')) ||
          (count == 2 && last <= request.time - duration.value(30, 'm') &&
            recallDay(request.time, offset) > recallDay(last, offset)));
    }

    function normalizedAnswer(text) {
      return text.lower().replace('[\\s_-]+', '');
    }

    function answerMatches(event, reference, referenceId) {
      let expected = event.answerDirection == 'en-to-ar' ? reference.get('translation', reference.get('meaning', '')) :
        reference.get('word', reference.get('text', ''));
      return nonEmptyString(event.submittedAnswer, 1000) &&
        (event.mode == 'scramble' ?
          event.answerDirection in ['en-to-ar', 'ar-to-en'] && nonEmptyString(expected, 1000) &&
            normalizedAnswer(event.submittedAnswer) == normalizedAnswer(expected) :
          event.submittedAnswer == referenceId);
    }

    function officialAnswerMatches(event, session, key, legacyId) {
      let world = session.officialReviewWorldId;
      let rank = session.officialReviewRankId;
      let gate = session.officialReviewGateId;
      let item = event.contentWordId;
      let word = get(/databases/$(database)/documents/content_worlds/$(world)/ranks/$(rank)/gates/$(gate)/words/$(item)).data;
      return word.status == 'published' && word.wordKey == key && answerMatches(event, word, legacyId);
    }

    function verifiedAnswerSource(event, session, canonical, uid, key) {
      let personal = session.sourceType == 'personal';
      let ref = personal ?
        /databases/$(database)/documents/users/$(uid)/words/$(canonical.legacyWordId) :
        /databases/$(database)/documents/users/$(uid)/customWorlds/$(session.privateWorldId)/words/$(event.membershipWordId);
      let word = get(ref).data;
      return word.get('wordKey', key) == key &&
        (personal ? word.get('personalDictionaryState', 'active') == 'active' : event.privateWorldId == session.privateWorldId) &&
        (session.get('officialReviewGateId', '') != '' ?
          officialAnswerMatches(event, session, key, canonical.legacyWordId) :
          answerMatches(event, word, personal ? canonical.legacyWordId : event.membershipWordId) ||
            (personal && answerMatches(event, canonical, canonical.legacyWordId)));
    }

    function validEvidenceAnswer(event, uid, key, id) {
      let path = /databases/$(database)/documents/users/$(uid)/contentWords/$(key);
      let canonical = get(path).data;
      let summary = getAfter(path).data;
      let session = get(/databases/$(database)/documents/users/$(uid)/quizEvidenceSessions/$(event.sessionId)).data;
      return event.keys().hasOnly(['eventId', 'sessionId', 'wordKey', 'sourceType', 'privateWorldId', 'membershipWordId',
          'mode', 'correct', 'completed', 'submittedAnswer', 'answerDirection', 'contentWordId', 'sequence', 'evidenceVersion',
          'timezoneOffsetMinutes', 'localDayKey', 'occurredAt']) &&
        event.eventId == id && id == 'e2~' + uid + '~' + event.sessionId + '~' + key && event.wordKey == key &&
        event.evidenceVersion == 2 && event.correct == true && event.completed == true &&
        event.sequence == canonical.get('eligibleEvidenceCount', 0) + 1 && event.sequence <= 3 &&
        event.occurredAt == request.time && summary.lastEvidenceEventId == id && summary.eligibleEvidenceCount == event.sequence &&
        session.mode == event.mode && validEvidenceMode(event.mode) && session.status == 'completed' &&
        session.sourceType == event.sourceType && key in session.correctWordKeys &&
        eligibleEvidenceTime(canonical, event) && verifiedAnswerSource(event, session, canonical, uid, key);
    }

    function validEvidenceProjection(before, after, uid, key) {
      let event = getAfter(/databases/$(database)/documents/users/$(uid)/contentWords/$(key)/evidence/$(after.lastEvidenceEventId)).data;
      return after.eligibleEvidenceCount == before.get('eligibleEvidenceCount', 0) + 1 &&
        after.eligibleEvidenceCount <= 3 && after.lastEligibleEvidenceAt == request.time &&
        after.updatedAt == request.time && event.occurredAt == request.time &&
        event.wordKey == key && event.sequence == after.eligibleEvidenceCount &&
        after.evidenceVersion == event.evidenceVersion && after.evidenceTimezoneOffsetMinutes == event.timezoneOffsetMinutes &&
        after.lastEvidenceLocalDayKey == event.localDayKey;
    }

    function validXpEvent(data, metaId) {
      return data.keys().hasOnly(['amount', 'reason', 'xpEconomyVersion', 'createdAt']) &&
        data.keys().size() == 4 &&
        data.amount is int && data.amount > 0 && data.amount <= 50 &&
        data.xpEconomyVersion is int && data.xpEconomyVersion >= 2 &&
        data.createdAt is timestamp &&
        ((data.reason == 'word_transition_new_learning' && data.amount == 2 &&
            metaId.matches('xp_event_word_transition:[^:]{1,180}:new_learning')) ||
          (data.reason == 'word_transition_learning_reviewing' && data.amount == 4 &&
            metaId.matches('xp_event_word_transition:[^:]{1,180}:learning_reviewing')) ||
          (data.reason == 'word_mastered_first' && data.amount == 8 &&
            metaId.matches('xp_event_word_transition:[^:]{1,180}:reviewing_mastered')) ||
          (data.reason == 'word_remastered' && data.amount == 3 &&
            metaId.matches('xp_event_word_transition:[^:]{1,180}:remastered:1')) ||
          (data.reason == 'daily_chest_unlock' &&
            metaId.matches('xp_event_daily_chest_unlock:[0-9]{1,20}')));
    }

    // Prepared learning content. Browser administration remains claim-gated;
    // public reads retain the production requirement for published ancestry.
    match /content_worlds/{worldId} {
      function validContentStatus(status) {
        return status == 'draft' || status == 'published' || status == 'archived';
      }

      function validWorldShape(data) {
        return data.worldId == worldId && validContentStatus(data.status) &&
          (!('title' in data) || nonEmptyString(data.title, 160)) &&
          (!('schemaVersion' in data) || data.schemaVersion == 1) &&
          (!('version' in data) || (data.version is int && data.version >= 0));
      }

      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin() && validWorldShape(request.resource.data);
      allow delete: if isAdmin();

      match /ranks/{rankId} {
        function validRankShape(data) {
          return data.worldId == worldId && data.rankId == rankId &&
            validContentStatus(data.status) &&
            (!('title' in data) || nonEmptyString(data.title, 160)) &&
            (!('schemaVersion' in data) || data.schemaVersion == 1) &&
            (!('version' in data) || (data.version is int && data.version >= 1));
        }

        allow read: if isAdmin() ||
          (resource.data.status == 'published' && publishedWorld(worldId));
        allow create, update: if isAdmin() && validRankShape(request.resource.data);
        allow delete: if isAdmin();

        match /gates/{gateId} {
          function validGateShape(data) {
            return data.worldId == worldId && data.rankId == rankId && data.gateId == gateId &&
              validContentStatus(data.status) &&
              (!('title' in data) || nonEmptyString(data.title, 160)) &&
              (!('schemaVersion' in data) || data.schemaVersion == 1) &&
              (!('version' in data) || (data.version is int && data.version >= 1));
          }

          allow read: if isAdmin() ||
            (resource.data.status == 'published' && publishedWorld(worldId) &&
              publishedRank(worldId, rankId));
          allow create, update: if isAdmin() && validGateShape(request.resource.data);
          allow delete: if isAdmin();

          match /words/{contentWordId} {
            function validContentWordShape(data) {
              return data.worldId == worldId && data.rankId == rankId &&
                data.gateId == gateId && data.contentWordId == contentWordId &&
                validContentStatus(data.status) &&
                nonEmptyString(data.word, 240) &&
                nonEmptyString(data.translation, 1000) &&
                (!('schemaVersion' in data) || data.schemaVersion == 1) &&
                (!('version' in data) || (data.version is int && data.version >= 1));
            }

            allow read: if isAdmin() ||
              (resource.data.status == 'published' && publishedWorld(worldId) &&
                publishedRank(worldId, rankId) && publishedGate(worldId, rankId, gateId));
            allow create, update: if isAdmin() && validContentWordShape(request.resource.data);
            allow delete: if isAdmin();
          }
        }
      }
    }

    match /content_word_import_staging/{stagingWordId} {
      allow read, create, update, delete: if isAdmin();
    }

    // These are server/Admin-SDK workflows. Client access remains denied.
    // Feedback v2 is an append-only client submission, not trusted learning metadata.
    // Both guests and signed-in users may submit; only admins can read responses.
    match /feedback/{feedbackId} {
      function validClientFeedback(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'rating', 'message', 'optionalName', 'ownerId', 'submittedAt'
          ]) && data.keys().hasAll([
            'schemaVersion', 'rating', 'message', 'optionalName', 'ownerId', 'submittedAt'
          ]) && data.schemaVersion == 2 &&
          data.rating is int && data.rating >= 1 && data.rating <= 5 &&
          data.message is string && data.message.size() <= 1600 &&
          data.optionalName is string && data.optionalName.size() <= 80 &&
          data.ownerId is string &&
          ((request.auth == null && data.ownerId == 'guest') ||
            (request.auth != null && data.ownerId == request.auth.uid)) &&
          data.submittedAt == request.time;
      }
      allow create: if feedbackId.matches('[A-Za-z0-9]{20}') &&
        validClientFeedback(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /admin_spark_content_operations/{adminUid}/treeJobs/{operationId} {
      allow get, delete: if isOwner(adminUid) && isAdmin();
      allow create: if isOwner(adminUid) && isAdmin() &&
        request.resource.data.keys().hasOnly(['fingerprint', 'gateCount', 'wordCount']) &&
        nonEmptyString(request.resource.data.fingerprint, 30000) &&
        request.resource.data.gateCount is int && request.resource.data.gateCount >= 0 &&
        request.resource.data.wordCount is int && request.resource.data.wordCount >= 0;
    }
    match /admin_spark_content_operations/{adminUid}/receipts/{operationId} {
      allow get: if isOwner(adminUid) && isAdmin();
      allow create: if isOwner(adminUid) && isAdmin() &&
        request.resource.data.keys().hasOnly(['adminUid', 'fingerprint', 'result', 'completedAt']) &&
        request.resource.data.adminUid == adminUid && nonEmptyString(request.resource.data.fingerprint, 30000) &&
        request.resource.data.result is map && request.resource.data.completedAt == request.time;
      allow update, delete: if false;
    }
    match /admin_audit_logs/{logId} { allow read: if isAdmin(); allow write: if false; }
    match /admins/{adminId} { allow read, write: if false; }

    match /users/{uid} {
      // No root-document list/write access; all application data is explicit.
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;

      match /savedGuestMerges/{id} {
        allow get: if isOwner(uid) || isOwner(resource.data.targetUid);
        allow create: if isOwner(uid) && !hasPermanentAccount() && id.matches('[a-f0-9]{64}') &&
          request.resource.data.keys().hasOnly(['targetUid', 'createdAt']) &&
          nonEmptyString(request.resource.data.targetUid, 128) && request.resource.data.targetUid != uid &&
          request.resource.data.createdAt == request.time;
        allow update: if isOwner(resource.data.targetUid) && hasPermanentAccount() &&
          !('completedAt' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt']) &&
          request.resource.data.completedAt == request.time;
      }

      match /savedGuestMerges/progress {
        allow get: if isOwner(uid) || (hasPermanentAccount() && isOwner(resource.data.targetUid));
        allow create: if isOwner(uid) && !hasPermanentAccount() &&
          request.resource.data.keys().hasOnly(['targetUid', 'createdAt']) &&
          nonEmptyString(request.resource.data.targetUid, 128) && request.resource.data.targetUid != uid &&
          request.resource.data.createdAt == request.time;
      }
      match /meta/saved_guest_import {
        function granted(sourceUid) {
          let grant = /databases/$(database)/documents/users/$(sourceUid)/savedGuestMerges/progress;
          return get(grant).data.targetUid == uid && !exists(savedGuestReceipt(uid, sourceUid));
        }
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && hasPermanentAccount() &&
          request.resource.data.keys().hasOnly(['sourceUid', 'startedAt']) &&
          nonEmptyString(request.resource.data.sourceUid, 128) && request.resource.data.sourceUid != uid &&
          request.resource.data.startedAt == request.time && granted(request.resource.data.sourceUid);
        allow delete: if isOwner(uid) && hasPermanentAccount() &&
          getAfter(savedGuestReceipt(uid, resource.data.sourceUid)).data.completedAt == request.time;
      }
      match /guestProgressImports/{sourceUid} {
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && hasPermanentAccount() && get(savedGuestPermit(uid)).data.sourceUid == sourceUid &&
          request.resource.data.keys().hasOnly(['sourceUid', 'sourceXP', 'xpDeduplicated', 'xpAdded',
            'runnerCoinsAdded', 'botsCoinsAdded', 'balanceAppliedAt']) &&
          request.resource.data.sourceUid == sourceUid && request.resource.data.balanceAppliedAt == request.time;
        allow update: if isOwner(uid) && hasPermanentAccount() && !('completedAt' in resource.data) &&
          get(savedGuestPermit(uid)).data.sourceUid == sourceUid && !existsAfter(savedGuestPermit(uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt']) &&
          request.resource.data.completedAt == request.time;
      }

      // Personal dictionary and custom worlds are owner-scoped. These docs do
      // not confer admin authority or access to another account.
      match /words/{wordId} {
        function validPersonalWord(data) {
          return data.userId == uid && data.meaning is string && data.meaning.size() <= 2000 &&
            data.category is string && data.category.size() <= 120 &&
            (('text' in data && nonEmptyString(data.text, 500)) ||
              ('word' in data && nonEmptyString(data.word, 500))) &&
            (!('forgetCount' in data) || (data.forgetCount is int && data.forgetCount >= 0)) &&
            (!('starred' in data) || data.starred is bool);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPersonalWord(request.resource.data);
      }
      match /customWorlds/{worldId} {
        function validCustomWorld(data) {
          return data.userId == uid && nonEmptyString(data.name, 240) &&
            (!('description' in data) || (data.description is string && data.description.size() <= 4000));
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCustomWorld(request.resource.data);
        match /words/{wordId} {
          function validCustomWorldWord(data) {
            return data.userId == uid && data.meaning is string && data.meaning.size() <= 2000 &&
              data.category is string && data.category.size() <= 120 &&
              (('text' in data && nonEmptyString(data.text, 500)) ||
                ('word' in data && nonEmptyString(data.word, 500)));
          }
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validCustomWorldWord(request.resource.data);
        }
      }

      // User settings, onboarding, XP metadata, and local quiz state.
      match /meta/profile {
        function validProfile(data) {
          return (!('userXP' in data) || (data.userXP is number && data.userXP >= 0)) &&
            (!('xpEconomyVersion' in data) ||
              (data.xpEconomyVersion is int && data.xpEconomyVersion >= 0)) &&
            (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0)) &&
            (!('maxStreak' in data) || (data.maxStreak is int && data.maxStreak >= 0)) &&
            (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validProfile(request.resource.data) &&
          request.resource.data.get('_syncRevision', 1) == 1;
        allow update: if isOwner(uid) && validProfile(request.resource.data) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['_syncRevision']) ||
            (request.resource.data._syncRevision is int && request.resource.data._syncRevision == resource.data.get('_syncRevision', 0) + 1));
        allow delete: if false;
      }
      match /meta/word_mastery {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['entries', 'updatedAt']) &&
          request.resource.data.entries is map && request.resource.data.entries.size() <= 5000;
        allow delete: if false;
      }
      match /meta/active_quiz_session { allow read, create, update, delete: if isOwner(uid); }
      match /meta/active_content_journey { allow read, create, update: if isOwner(uid); allow delete: if false; }
      match /meta/{metaId} {
        function validProfileReceipt(data) {
          return metaId.matches('xp_event_profile_sync_v1_.+') && metaId.size() <= 1225 && data.createdAt is timestamp &&
            (data.type == 'profile-sync-v1' ? data.keys().hasOnly(['type', 'operationId', 'result', 'createdAt']) &&
              nonEmptyString(data.operationId, 1200) && data.result is map && data.result.applied is bool && data.result.reason is string :
              data.type == 'profile-extra-consumed-v1' && data.keys().hasOnly(['type', 'createdAt']));
        }
        function validMotivationReceipt(data) {
          return data.createdAt is timestamp &&
            (data.reason == 'motivation_gate_counted' && data.amount == 0 && data.keys().hasOnly(['reason', 'amount', 'createdAt']) ||
              data.reason == 'motivation_milestone' && data.amount in [20, 25, 35, 60, 100] &&
              data.at is number && nonEmptyString(data.rewardId, 500) &&
              data.keys().hasOnly(['reason', 'amount', 'createdAt', 'at', 'rewardId']));
        }
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && metaId.matches('xp_event_motivation_[a-f0-9]{64}') && validMotivationReceipt(request.resource.data);
        allow read: if isOwner(uid) && metaId.matches('xp_event_.*');
        allow create: if isOwner(uid) && (metaId.matches('xp_event_profile_sync_v1_.*')
          ? validProfileReceipt(request.resource.data) : validXpEvent(request.resource.data, metaId));
        allow update, delete: if false;
      }

      match /guidedFirstJourneys/{versionId} {
        function validGuidedJourney(data) {
          return data.version == 1 && data.audience == 'new' &&
            data.phase in [
              'awaiting-first-gate', 'first-gate-opened',
              'awaiting-quiz-cta', 'completed'
            ] && nonEmptyString(data.worldId, 128) &&
            data.guestDictionaryAvailable is bool && data.startedAt is timestamp &&
            data.updatedAt is timestamp &&
            ((data.phase == 'completed' && data.completedAt is timestamp) ||
              (data.phase != 'completed' && data.completedAt == null));
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && versionId == 'v1' &&
          validGuidedJourney(request.resource.data);
        allow update: if isOwner(uid) && versionId == 'v1' &&
          validGuidedJourney(request.resource.data) &&
          request.resource.data.version == resource.data.version &&
          request.resource.data.audience == resource.data.audience &&
          request.resource.data.worldId == resource.data.worldId &&
          request.resource.data.startedAt == resource.data.startedAt &&
          (resource.data.guestDictionaryAvailable == false ||
            request.resource.data.guestDictionaryAvailable == true) &&
          (
            (resource.data.phase == 'awaiting-first-gate' &&
              request.resource.data.phase in ['awaiting-first-gate', 'first-gate-opened']) ||
            (resource.data.phase == 'first-gate-opened' &&
              request.resource.data.phase in ['first-gate-opened', 'awaiting-quiz-cta']) ||
            (resource.data.phase == 'awaiting-quiz-cta' &&
              request.resource.data.phase in ['awaiting-quiz-cta', 'completed'])
          );
        allow delete: if false;
      }
      match /entryExperiences/{versionId} {
        allow read, create, update: if isOwner(uid) && versionId.matches('v[0-9]+');
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        function validNotification(data) {
          return data.ownerId == uid && data.id == notificationId &&
            data.status in ['pending', 'active', 'resolved', 'dismissed'] &&
            data.message is string && data.message.size() <= 4000 &&
            (!('priority' in data) || (data.priority is int && data.priority >= 0 && data.priority <= 100));
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNotification(request.resource.data);
        allow delete: if false;
      }

      match /testSettings/clock {
        allow read, create, update: if isOwner(uid) && isAdmin() &&
          'testClock' in request.auth.token && request.auth.token.testClock == true;
        allow delete: if false;
      }

      // Journey, placement, level-placement, and gate-clear documents are
      // owner-scoped with stable path identities and basic state shapes. The
      // production ruleset adds the remaining cross-document/batch invariants.
      match /contentProgress/{worldId} {
        function validJourney(data) {
          return data.worldId == worldId && data.journeyVersion == 1 &&
            data.status in ['active', 'paused'] &&
            nonEmptyString(data.activeRankId, 128) && nonEmptyString(data.activeGateId, 128) &&
            data.startedAt is timestamp && data.updatedAt is timestamp &&
            data.placementStatus in ['not-started', 'active', 'completed', 'declined'] &&
            (!('activePlacementAssessmentId' in data) ||
              (data.activePlacementAssessmentId is string && data.activePlacementAssessmentId.size() <= 500)) &&
            (!('activeLevelPlacementAssessmentId' in data) ||
              (data.activeLevelPlacementAssessmentId is string && data.activeLevelPlacementAssessmentId.size() <= 500));
        }
        allow read: if isOwner(uid);
        function legacyPlacementAdvance(before, after, id) {
          let result = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/placementSessions/$(id)).data;
          let gate = getAfter(ownerGatePath(uid, worldId, before.activeRankId, before.activeGateId)).data;
          return after.get('activePlacementAssessmentId', '') == '' &&
            after.diff(before).affectedKeys().hasOnly(['activeRankId', 'activeGateId', 'placementStatus',
              'activePlacementAssessmentId', 'unlockedRankIds', 'unlockedGateIds', 'updatedAt']) &&
            result.rankId == before.activeRankId && result.currentGateId == before.activeGateId &&
            publishedGate(worldId, after.activeRankId, after.activeGateId) &&
            ((result.status == 'completed' && result.outcome == 'passed' && gate.clearedBy == 'placement' && gate.placementAssessmentId == id &&
              after.unlockedRankIds.toSet() == before.unlockedRankIds.toSet().union([after.activeRankId].toSet()) &&
              after.unlockedGateIds.toSet() == before.unlockedGateIds.toSet().union([after.activeGateId].toSet())) ||
              (result.status == 'abandoned' && after.placementStatus == 'declined' &&
                after.activeRankId in before.unlockedRankIds && after.activeGateId in before.unlockedGateIds &&
                after.unlockedRankIds == [after.activeRankId] && after.unlockedGateIds == [after.activeGateId]));
        }
        function levelPlacementAdvance(before, after, id) {
          let result = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/levelPlacementSessions/$(id)).data;
          return result.status == 'completed' && result.resultApplied == true && result.completedAt == request.time &&
            after.get('activeLevelPlacementAssessmentId', '') == '' &&
            after.activeRankId == (result.resultStartRankId == '' ? before.activeRankId : result.resultStartRankId) &&
            after.activeGateId == (result.resultStartGateId == '' ? before.activeGateId : result.resultStartGateId) &&
            after.unlockedRankIds.toSet() == before.unlockedRankIds.toSet().union(result.resultUnlockedRankIds.toSet()) &&
            after.unlockedGateIds.toSet() == before.unlockedGateIds.toSet().union(result.resultUnlockedGateIds.toSet()) &&
            after.get('levelPlacementClearedGateIds', []).toSet() == before.get('levelPlacementClearedGateIds', []).toSet().union(result.resultClearedGateIds.toSet()) &&
            after.contentJourneyStatus == (result.completedCurrentContent == true ? 'completed-current-content' : 'in-progress');
        }
        function placementAllowsAdvance(before, after) {
          let id = before.get('activePlacementAssessmentId', '');
          let level = before.get('activeLevelPlacementAssessmentId', '');
          return (id != '' && legacyPlacementAdvance(before, after, id)) ||
            (level != '' && levelPlacementAdvance(before, after, level)) ||
            (before.get('contentJourneyStatus', '') == 'completed-current-content' && after.contentJourneyStatus == 'in-progress' &&
              after.diff(before).affectedKeys().hasOnly(['contentJourneyStatus', 'updatedAt', 'status']));
        }
        function cleanPlacementStart(data) {
          return data.status == 'active' && data.currentQuestionIndex == 0 && data.answers == [] && data.correctCount == 0;
        }
        function placementAnswerStep(before, after, questionId, idField, selectedField) {
          let answer = after.answers[before.currentQuestionIndex];
          return before.status == 'active' && after.currentQuestionIndex == before.currentQuestionIndex + 1 &&
            after.answers.size() == after.currentQuestionIndex && after.answers.removeAll([answer]) == before.answers &&
            answer[idField] == questionId && nonEmptyString(answer[selectedField], 500) &&
            answer.correct == (answer[selectedField] == questionId) &&
            after.correctCount == before.correctCount + (answer.correct ? 1 : 0);
        }
        function publishedPlacementWord(rankId, gateId, wordId, key) {
          let word = get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(rankId)/gates/$(gateId)/words/$(wordId)).data;
          return word.status == 'published' && word.wordKey == key;
        }
        function placementAnswersUnchanged(before, after) {
          return after.currentQuestionIndex == before.currentQuestionIndex && after.answers == before.answers &&
            after.correctCount == before.correctCount;
        }
        function placementAnswersComplete(data, size) {
          return size > 0 && data.currentQuestionIndex == size && data.answers.size() == size;
        }
        function unchangedJourneyTarget(before, after) {
          return !after.diff(before).affectedKeys().hasAny(['activeRankId', 'activeGateId',
            'unlockedRankIds', 'unlockedGateIds', 'contentJourneyStatus', 'levelPlacementClearedGateIds',
            'completedRankIds', 'rankCompletionVersions', 'worldCompletion']);
        }
        function finishedJourney(before, after) {
          let gate = getAfter(ownerGatePath(uid, worldId, before.activeRankId, before.activeGateId)).data;
          return gate.status == 'cleared' && gate.clearedBy == 'gate-clear' && gate.clearedAt == request.time &&
            gate.get('nextGateId', '') == '' && after.activeGateId == before.activeGateId && after.activeRankId == before.activeRankId &&
            after.unlockedRankIds == before.unlockedRankIds && after.unlockedGateIds == before.unlockedGateIds;
        }
        allow create, update: if importingSavedGuest(uid) && validJourney(request.resource.data);
        allow create: if isOwner(uid) && validJourney(request.resource.data) &&
          request.resource.data.unlockedRankIds == [request.resource.data.activeRankId] &&
          request.resource.data.unlockedGateIds == [request.resource.data.activeGateId] &&
          request.resource.data.placementStatus == 'not-started' &&
          request.resource.data.get('completedRankIds', []) == [] &&
          request.resource.data.get('levelPlacementClearedGateIds', []) == [] &&
          get(/databases/$(database)/documents/content_worlds/$(worldId)/ranks/$(request.resource.data.activeRankId)).data.get('unlockConfig', {}).get('initialStatus', '') == 'available' &&
          publishedGate(worldId, request.resource.data.activeRankId, request.resource.data.activeGateId);
        allow update: if isOwner(uid) && validJourney(request.resource.data) &&
          (unchangedJourneyTarget(resource.data, request.resource.data) ||
            (resource.data.activeGateId != request.resource.data.activeGateId &&
              normalProgressAdvance(resource.data, request.resource.data, uid, worldId)) ||
            (request.resource.data.get('contentJourneyStatus', '') == 'completed-current-content' &&
              finishedJourney(resource.data, request.resource.data)) || placementAllowsAdvance(resource.data, request.resource.data));
        allow delete: if false;
        match /placementSessions/{assessmentId} {
          function validPlacementSession(data) {
            return data.assessmentId == assessmentId && data.worldId == worldId &&
              data.status in ['active', 'submitting', 'completed', 'abandoned'] &&
              nonEmptyString(data.rankId, 128) && nonEmptyString(data.currentGateId, 128) &&
              (!('currentQuestionIndex' in data) ||
                (data.currentQuestionIndex is int && data.currentQuestionIndex >= 0)) &&
              data.startedAt is timestamp && data.updatedAt is timestamp;
          }
          allow read: if isOwner(uid);
          function validLegacyPlacementStart(data) {
            let gate = get(gateContentPath(worldId, data.rankId, data.currentGateId)).data;
            let order = data.orderedContentWordIds;
            let configuredRatio = gate.get('entryAssessmentPassRatio', null);
            let ratio = configuredRatio == null || configuredRatio == '' ? 0.75 : configuredRatio;
            return cleanPlacementStart(data) && gate.status == 'published' && order.size() > 0 && order.size() <= 2000 &&
              order.toSet().size() == order.size() && order.toSet() == gate.get('publishedWordIds', order).toSet() &&
              data.orderedWordKeys.size() == order.size() && data.totalQuestions == order.size() && data.passThreshold == ratio &&
              data.requiredCorrect is int && data.requiredCorrect >= data.totalQuestions * ratio && data.requiredCorrect - 1 < data.totalQuestions * ratio;
          }
          function validPlacementUpdate(before, after) {
            let order = before.orderedContentWordIds;
            return !after.diff(before).affectedKeys().hasAny(['rankId', 'currentGateId', 'orderedContentWordIds',
              'orderedWordKeys', 'totalQuestions', 'passThreshold', 'requiredCorrect', 'startedAt']) &&
              (after.currentQuestionIndex == before.currentQuestionIndex ? placementAnswersUnchanged(before, after) &&
                (after.status == before.status || after.status == 'abandoned' ||
                  (before.status == 'submitting' && after.status == 'completed' && placementAnswersComplete(before, order.size()) &&
                  after.outcome == (before.correctCount >= before.requiredCorrect ? 'passed' : 'failed'))) :
                placementAnswerStep(before, after, order[before.currentQuestionIndex], 'contentWordId', 'selectedContentWordId') &&
                after.status == (after.currentQuestionIndex == order.size() ? 'submitting' : 'active') &&
                publishedPlacementWord(before.rankId, before.currentGateId, order[before.currentQuestionIndex], before.orderedWordKeys[before.currentQuestionIndex]));
          }
          allow create: if importingSavedGuest(uid) && validPlacementSession(request.resource.data);
          allow create: if isOwner(uid) && validPlacementSession(request.resource.data) && validLegacyPlacementStart(request.resource.data);
          allow update: if isOwner(uid) && validPlacementSession(request.resource.data) && validPlacementUpdate(resource.data, request.resource.data);
          allow delete: if false;
        }
        match /levelPlacementSessions/{assessmentId} {
          function validLevelPlacementSession(data) {
            return data.assessmentId == assessmentId && data.worldId == worldId &&
              data.status in ['active', 'submitting', 'awaiting-decision', 'completed', 'paused', 'abandoned'] &&
              data.cefrLevel in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'] &&
              (!('currentQuestionIndex' in data) ||
                (data.currentQuestionIndex is int && data.currentQuestionIndex >= 0)) &&
              data.startedAt is timestamp && data.updatedAt is timestamp;
          }
          allow read: if isOwner(uid);
          function validLevelPlacementWord(answer) {
            return publishedPlacementWord(answer.rankId, answer.gateId, answer.contentWordId, answer.wordKey);
          }
          function validLevelPlacementUpdate(before, after) {
            let order = before.orderedQuestionIds;
            let changed = after.diff(before).affectedKeys();
            return !changed.hasAny(['cefrLevel', 'selectedWords', 'selectedContentWordIds', 'startedAt']) &&
              (before.get('resultApplied', false) == false || !changed.hasAny(['status', 'resultApplied', 'completedAt',
                'resultStartRankId', 'resultStartGateId', 'resultUnlockedRankIds', 'resultUnlockedGateIds',
                'resultClearedGateIds', 'completedCurrentContent', 'passedRankIds'])) &&
              (after.currentQuestionIndex == before.currentQuestionIndex ? placementAnswersUnchanged(before, after) &&
                after.orderedQuestionIds == order &&
                (after.status != 'awaiting-decision' || before.status == 'awaiting-decision') &&
                (after.status != 'completed' || before.status == 'completed' ||
                  (before.status in ['awaiting-decision', 'paused'] && placementAnswersComplete(before, order.size()))) :
                placementAnswerStep(before, after, order[before.currentQuestionIndex], 'questionId', 'selectedQuestionId') &&
                after.orderedQuestionIds.hasAll(order) && validLevelPlacementWord(after.answers[before.currentQuestionIndex]) &&
                (after.status == 'active' || (after.status == 'awaiting-decision' && placementAnswersComplete(after, order.size()))));
          }
          allow create: if importingSavedGuest(uid) && validLevelPlacementSession(request.resource.data);
          allow create: if isOwner(uid) && validLevelPlacementSession(request.resource.data) && cleanPlacementStart(request.resource.data);
          allow update: if isOwner(uid) && validLevelPlacementSession(request.resource.data) && validLevelPlacementUpdate(resource.data, request.resource.data);
          allow delete: if false;
        }
        match /gateClearAttempts/{attemptId} {
          function validGateClearAttempt(data) {
            return data.attemptId == attemptId && data.worldId == worldId &&
              nonEmptyString(data.rankId, 128) && nonEmptyString(data.gateId, 128) &&
              data.status in ['active', 'submitting', 'passed', 'failed', 'abandoned'] &&
              data.startedAt is timestamp && data.updatedAt is timestamp &&
              (!('currentQuestionIndex' in data) ||
                (data.currentQuestionIndex is int && data.currentQuestionIndex >= 0));
          }

          function validGateClearAnswer(answer, expectedContentWordId, questionOrder) {
            return answer is map &&
              answer.keys().hasOnly([
                'contentWordId', 'selectedContentWordId', 'correct'
              ]) &&
              answer.keys().hasAll([
                'contentWordId', 'selectedContentWordId', 'correct'
              ]) &&
              answer.contentWordId == expectedContentWordId &&
              nonEmptyString(answer.contentWordId, 128) &&
              nonEmptyString(answer.selectedContentWordId, 128) &&
              answer.selectedContentWordId in questionOrder &&
              answer.correct == (answer.selectedContentWordId == answer.contentWordId);
          }

          function validAttemptCohort(data) {
            let progress = get(ownerGatePath(uid, worldId, data.rankId, data.gateId)).data;
            let journey = get(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)).data;
            return journey.status == 'active' && journey.activeGateId == data.gateId && journey.activeRankId == data.rankId &&
              progress.status == 'ready' && progress.get('activeClearAttemptId', '') == '' &&
              data.questionOrder.toSet() == progress.loadedContentWordIds.toSet() &&
              completeGateProof(uid, progress, worldId, data.rankId, data.gateId, data.passRatio);
          }

          function validGateClearAttemptCreate(data) {
            return validGateClearAttempt(data) &&
              data.keys().hasOnly([
                'attemptId', 'worldId', 'rankId', 'gateId', 'questionOrder',
                'answers', 'currentQuestionIndex', 'correctCount', 'totalCount',
                'passRatio', 'requiredCorrect', 'status', 'gateClearVersion',
                'startedAt', 'updatedAt'
              ]) &&
              data.questionOrder is list && data.questionOrder.size() > 0 &&
              data.questionOrder.size() <= 2000 &&
              data.questionOrder.toSet().size() == data.questionOrder.size() &&
              data.answers is list && data.answers.size() == 0 &&
              data.currentQuestionIndex == 0 && data.correctCount == 0 &&
              data.totalCount == data.questionOrder.size() &&
              data.passRatio is number && data.passRatio > 0 && data.passRatio <= 1 &&
              data.requiredCorrect is int &&
              data.requiredCorrect >= data.totalCount * data.passRatio &&
              data.requiredCorrect - 1 < data.totalCount * data.passRatio &&
              data.status == 'active' && data.gateClearVersion == 1 &&
              data.startedAt == request.time && data.updatedAt == request.time && validAttemptCohort(data);
          }

          function validGateClearAnswerUpdate(before, after) {
            return validGateClearAttempt(after) &&
              before.status == 'active' &&
              after.diff(before).affectedKeys().hasOnly([
                'answers', 'currentQuestionIndex', 'correctCount', 'status', 'updatedAt'
              ]) &&
              after.answers.size() == before.answers.size() + 1 &&
              after.answers.removeAll([after.answers[before.answers.size()]]) == before.answers &&
              after.currentQuestionIndex == before.currentQuestionIndex + 1 &&
              after.currentQuestionIndex == after.answers.size() &&
              after.currentQuestionIndex <= after.totalCount &&
              validGateClearAnswer(
                after.answers[before.answers.size()],
                before.questionOrder[before.currentQuestionIndex],
                before.questionOrder
              ) &&
              after.correctCount == before.correctCount +
                (after.answers[before.answers.size()].correct ? 1 : 0) &&
              after.updatedAt == request.time &&
              (
                (after.currentQuestionIndex < after.totalCount && after.status == 'active') ||
                (after.currentQuestionIndex == after.totalCount && after.status == 'submitting')
              );
          }

          function validGateClearAttemptFinish(before, after) {
            return validGateClearAttempt(after) &&
              before.status == 'submitting' &&
              after.diff(before).affectedKeys().hasOnly([
                'status', 'result', 'score', 'completedAt', 'updatedAt'
              ]) &&
              before.currentQuestionIndex == before.totalCount &&
              before.answers.size() == before.totalCount &&
              after.score == after.correctCount / after.totalCount &&
              after.completedAt == request.time && after.updatedAt == request.time &&
              (
                (before.correctCount >= before.requiredCorrect &&
                  after.status == 'passed' && after.result == 'passed') ||
                (before.correctCount < before.requiredCorrect &&
                  after.status == 'failed' && after.result == 'failed')
              );
          }

          function validGateClearAttemptAbandon(before, after) {
            return validGateClearAttempt(after) &&
              before.status == 'active' &&
              after.diff(before).affectedKeys().hasOnly([
                'status', 'abandonedAt', 'updatedAt'
              ]) &&
              after.status == 'abandoned' && after.abandonedAt == request.time &&
              after.updatedAt == request.time;
          }
          allow read: if isOwner(uid);
          allow create: if importingSavedGuest(uid) && validGateClearAttempt(request.resource.data);
          allow create: if isOwner(uid) && validGateClearAttemptCreate(request.resource.data);
          allow update: if isOwner(uid) && (
            validGateClearAnswerUpdate(resource.data, request.resource.data) ||
            validGateClearAttemptFinish(resource.data, request.resource.data) ||
            validGateClearAttemptAbandon(resource.data, request.resource.data)
          );
          allow delete: if false;
        }
        match /ranks/{rankId}/gates/{gateId} {
          function validGateProgress(data) {
            return data.worldId == worldId && data.rankId == rankId && data.gateId == gateId &&
              data.journeyVersion == 1 &&
              data.status in ['available', 'learning', 'ready', 'cleared'] &&
              data.lastActivityAt is timestamp && data.readyEvidenceCount is int &&
              data.readyEvidenceCount >= 0 && data.clearAttempts is int && data.clearAttempts >= 0 &&
              (!('clearCorrect' in data) || (data.clearCorrect is int && data.clearCorrect >= 0)) &&
              (!('clearTotal' in data) || (data.clearTotal is int && data.clearTotal >= 0));
          }
          function linkedAttempt(id) {
            let attempt = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/gateClearAttempts/$(id)).data;
            return attempt.status == 'active' && attempt.startedAt == request.time && attempt.gateId == gateId && attempt.rankId == rankId;
          }
          function closedAttempt(id) {
            let attempt = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/gateClearAttempts/$(id)).data;
            return (attempt.status == 'failed' && attempt.completedAt == request.time) ||
              (attempt.status == 'abandoned' && attempt.abandonedAt == request.time);
          }
          function validReviewMarker(before, after) {
            let id = after.runnerReviewCompletedSessionId;
            let session = get(/databases/$(database)/documents/users/$(uid)/quizEvidenceSessions/$(id)).data;
            let previous = before.get('runnerReviewCompletedSessionId', '');
            return session.officialReviewWorldId == worldId && session.officialReviewRankId == rankId &&
              session.officialReviewGateId == gateId && after.runnerReviewCompletedDueWordKeys == session.officialReviewDueWordKeys &&
              after.loadedWordKeys.hasAll(after.runnerReviewCompletedDueWordKeys) && session.completedAt >= before.loadedAt &&
              (previous == '' || session.completedAt > get(/databases/$(database)/documents/users/$(uid)/quizEvidenceSessions/$(previous)).data.completedAt);
          }
          function validLevelPlacementGate(id) {
            let result = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/levelPlacementSessions/$(id)).data;
            return result.status == 'completed' && result.resultApplied == true &&
              gateId in result.resultClearedGateIds && rankId in result.passedRankIds;
          }
          function validLegacyPlacementGate(id) {
            let result = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/placementSessions/$(id)).data;
            return result.rankId == rankId && result.currentGateId == gateId && result.status in ['submitting', 'completed'] &&
              placementAnswersComplete(result, result.orderedContentWordIds.size()) && result.correctCount >= result.requiredCorrect;
          }
          function placementGate(gate) {
            let source = gate.get('clearedBy', '');
            return gate.status == 'cleared' && publishedGate(worldId, rankId, gateId) &&
              (source == 'level-placement' ? nonEmptyString(gate.get('levelPlacementAssessmentId', ''), 500) && validLevelPlacementGate(gate.levelPlacementAssessmentId) :
               source == 'placement' && nonEmptyString(gate.get('placementAssessmentId', ''), 500) && validLegacyPlacementGate(gate.placementAssessmentId));
          }
          function validReviewChange(before, after) {
            return !after.diff(before).affectedKeys().hasAny([
              'runnerReviewCompletedSessionId', 'runnerReviewCompletedDueWordKeys'
            ]) || validReviewMarker(before, after);
          }
          function validLearningGate(before, after) {
            return (before.status in ['available', 'learning'] &&
                after.readyEvidenceCount < after.get('requiredWordCount', 1) &&
                after.loadedContentWordIds.hasAll(before.get('loadedContentWordIds', [])) &&
                after.loadedWordKeys.hasAll(before.get('loadedWordKeys', [])) &&
                after.get('activeClearAttemptId', '') == before.get('activeClearAttemptId', '') &&
                after.clearAttempts == before.clearAttempts && validReviewChange(before, after)) ||
              (before.status == 'cleared' && before.get('clearedBy', '') == 'placement');
          }
          function validReadyGate(before, after) {
            let oldAttempt = before.get('activeClearAttemptId', '');
            let newAttempt = after.get('activeClearAttemptId', '');
            return before.status in ['learning', 'ready'] && sameLoadedGate(before, after) &&
              after.readyEvidenceCount == after.loadedWordKeys.size() &&
              (oldAttempt == newAttempt ||
                (oldAttempt == '' && nonEmptyString(newAttempt, 500) && linkedAttempt(newAttempt)) ||
                (newAttempt == '' && nonEmptyString(oldAttempt, 500) && closedAttempt(oldAttempt))) &&
              validReviewChange(before, after) && completeGateProof(uid, after, worldId, rankId, gateId, null);
          }
          function validClearedGate(before, after) {
            let source = after.get('clearedBy', '');
            return (before.status == 'cleared' && source == before.get('clearedBy', '') &&
                (source != 'gate-clear' || (sameLoadedGate(before, after) && after.clearedAt == before.clearedAt))) ||
              (source == 'gate-clear' ? before.status == 'ready' && sameLoadedWords(before, after) &&
                completeGateProof(uid, before, worldId, rankId, gateId, null) &&
                passedActiveAttempt(before, after, uid, worldId, rankId, gateId) : placementGate(after));
          }
          function validGateUpdate(before, after) {
            return after.status == 'learning' ? validLearningGate(before, after) :
              after.status == 'ready' ? validReadyGate(before, after) :
              after.status == 'cleared' && validClearedGate(before, after);
          }
          allow read: if isOwner(uid);
          function unlockedGate() {
            let journey = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)).data;
            return rankId in journey.unlockedRankIds && gateId in journey.unlockedGateIds;
          }
          allow create, update: if importingSavedGuest(uid) && validGateProgress(request.resource.data);
          allow create: if isOwner(uid) && validGateProgress(request.resource.data) &&
            ((request.resource.data.status in ['available', 'learning'] && request.resource.data.readyEvidenceCount == 0 &&
              request.resource.data.get('activeClearAttemptId', '') == '' && unlockedGate()) || placementGate(request.resource.data));
          allow update: if isOwner(uid) && validGateProgress(request.resource.data) && validGateUpdate(resource.data, request.resource.data);
          allow delete: if false;

          match /readiness/proof {
            allow read: if isOwner(uid);
            allow create, update: if importingSavedGuest(uid) && request.resource.data.keys().hasOnly(['wordIds', 'addedWordId', '_savedGuestImportedAt']) &&
              request.resource.data.wordIds is list && request.resource.data.wordIds.size() <= 2000;
            allow create: if isOwner(uid) && validProofAppend(request.resource.data, [], uid, worldId, rankId, gateId);
            allow update: if isOwner(uid) && validProofAppend(request.resource.data, resource.data.wordIds, uid, worldId, rankId, gateId);
            allow delete: if false;
          }
        }
      }

      match /quizEvidenceSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if importingSavedGuest(uid) && request.resource.data.sessionId == sessionId && request.resource.data.status == 'completed';
        allow create: if isOwner(uid) && validEvidenceSession(request.resource.data, uid, sessionId);
        allow update, delete: if false;
      }
      match /contentOperations/{operationId} { allow read: if isOwner(uid); allow write: if false; }

      match /contentWords/{contentWordId} {
        function validContentWord(data) {
          return data.canonicalId == contentWordId && data.wordKey == contentWordId &&
            data.normalizationVersion == 1 && data.schemaVersion == 1 &&
            nonEmptyString(data.word, 240) && nonEmptyString(data.normalizedWord, 240) &&
            nonEmptyString(data.masteryKey, 240) &&
            (!('translation' in data) ||
              (data.translation is string && data.translation.size() <= 1000)) &&
            data.forgetCount is int && data.forgetCount >= 0 && data.forgetCount <= 100000 &&
            (!('sourceCount' in data) || (data.sourceCount is int && data.sourceCount >= 0)) &&
            (!('eligibleEvidenceCount' in data) ||
              (data.eligibleEvidenceCount is int && data.eligibleEvidenceCount >= 0 &&
                data.eligibleEvidenceCount <= 3));
        }
        allow read: if isOwner(uid);
        function evidenceFields() {
          return ['eligibleEvidenceCount', 'lastEligibleEvidenceAt', 'lastEvidenceEventId', 'evidenceVersion',
            'evidenceTimezoneOffsetMinutes', 'lastEvidenceLocalDayKey'];
        }
        allow create, update: if importingSavedGuest(uid) && validContentWord(request.resource.data);
        allow create: if isOwner(uid) && validContentWord(request.resource.data) &&
          request.resource.data.get('eligibleEvidenceCount', 0) == 0 &&
          request.resource.data.get('lastEligibleEvidenceAt', null) == null &&
          request.resource.data.get('lastEvidenceEventId', '') == '';
        allow update: if isOwner(uid) && validContentWord(request.resource.data) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(evidenceFields()) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(evidenceFields().concat(['updatedAt'])) &&
              validEvidenceProjection(resource.data, request.resource.data, uid, contentWordId)));
        allow delete: if false;
        match /sources/{sourceId} {
          function validSource(data) {
            return data.addedFrom in [
                'manual', 'dictionary-search', 'private-world', 'import',
                'published-gate', 'level-placement'
              ] && nonEmptyString(data.operationId, 180) &&
              data.linkedAt is timestamp &&
              (!('customWorldId' in data) || nonEmptyString(data.customWorldId, 500)) &&
              (!('importId' in data) || nonEmptyString(data.importId, 500));
          }
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validSource(request.resource.data);
          allow update: if false;
        }
        match /evidence/{eventId} {
          allow read: if isOwner(uid);
          allow create: if importingSavedGuest(uid) && request.resource.data.wordKey == contentWordId && request.resource.data.eventId == eventId;
          allow create: if isOwner(uid) && validEvidenceAnswer(request.resource.data, uid, contentWordId, eventId);
          allow update, delete: if false;
        }
      }
    }

    // Shared cache has intentionally public reads in production. Writes are
    // authenticated; only claim-based admins may remove entries.
    match /ai_global_cache/{cacheId} {
      function validCacheDocument(data) {
        return data.keys().hasOnly([
            'word', 'caches', 'type', 'meanings', 'meaning', 'createdAt'
          ]) &&
          nonEmptyString(data.word, 500) &&
          ('caches' in data || 'type' in data) &&
          (!('caches' in data) || data.caches is map) &&
          (!('type' in data) || data.type == 'normal' || data.type == 'gamer') &&
          (!('meanings' in data) || data.meanings is list) &&
          (!('meaning' in data) || data.meaning is string ||
            data.meaning is list || data.meaning is map);
      }

      allow read: if true;
      allow create: if hasPermanentAccount() && validCacheDocument(request.resource.data);
      allow update: if isAdmin() || (
        hasPermanentAccount() && validCacheDocument(request.resource.data) &&
        request.resource.data.word == resource.data.word
      );
      allow delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow create: if hasPermanentAccount() &&
        nonEmptyString(request.resource.data.word, 500) &&
        request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
