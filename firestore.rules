              'orderedContentWordIds', 'orderedWordKeys', 'answers', 'correctCount', 'totalQuestions',
              'passThreshold', 'requiredCorrect', 'status', 'source', 'suppressRewards', 'answersComplete',
              'wordsLinked', 'gateProgressSaved', 'placementCompleted', 'nextGateUnlocked',
              'completionStep', 'placementVersion', 'startedAt', 'updatedAt', 'outcome', 'score',
