          function validLearningGate(before, after) {
            return (!after.diff(before).affectedKeys().hasAny(['placementAssessmentId', 'placementScore',
                'placementCorrect', 'placementTotal']) ||
              (nonEmptyString(after.get('placementAssessmentId', ''), 500) &&
                after.get('clearedBy', '') == '' &&
                validLegacyPlacementGate(after, after.placementAssessmentId, false))) &&
              ((before.status in ['available', 'learning'] &&
                after.readyEvidenceCount < after.get('requiredWordCount', 1) &&
                after.loadedContentWordIds.hasAll(before.get('loadedContentWordIds', [])) &&
                after.loadedWordKeys.hasAll(before.get('loadedWordKeys', [])) &&
                after.get('activeClearAttemptId', '') == before.get('activeClearAttemptId', '') &&
                after.clearAttempts == before.clearAttempts && validReviewChange(before, after)) ||
              (before.status == 'cleared' && before.get('clearedBy', '') == 'placement'));
          }
          function validReadyGate(before, after) {
            let oldAttempt = before.get('activeClearAttemptId', '');
            let newAttempt = after.get('activeClearAttemptId', '');
            let readyAt = after.get('readyAt', null);
            return before.status in ['learning', 'ready'] && sameLoadedGate(before, after) &&
              (!(readyAt is timestamp) || readyAt == request.time || readyAt == before.get('readyAt', null)) &&
              after.readyEvidenceCount == after.loadedWordKeys.size() &&
              (oldAttempt == newAttempt ||
                (oldAttempt == '' && nonEmptyString(newAttempt, 500) && linkedAttempt(newAttempt)) ||
                (newAttempt == '' && nonEmptyString(oldAttempt, 500) && closedAttempt(oldAttempt))) &&
              validReviewChange(before, after) && completeGateProof(uid, after, worldId, rankId, gateId, null);
          }
          function validClearedGate(before, after) {
            let source = after.get('clearedBy', '');
            return (before.status == 'cleared' && source == before.get('clearedBy', '') &&
                (source != 'gate-clear' || (sameLoadedGate(before, after) && after.clearedAt == before.clearedAt))) ||
              (source == 'gate-clear' ? before.status == 'ready' && sameLoadedWords(before, after) &&
                completeGateProof(uid, before, worldId, rankId, gateId, null) &&
                passedActiveAttempt(before, after, uid, worldId, rankId, gateId) : placementGate(after));
          }
          function validGateUpdate(before, after) {
            return after.get('masteryComplete', false) == before.get('masteryComplete', false) &&
              stableLoadedAt(before, after) && (after.status == 'learning' ? validLearningGate(before, after) :
              after.status == 'ready' ? validReadyGate(before, after) :
              after.status == 'cleared' && validClearedGate(before, after));
          }
          function importedGateKeepsDates(before, after) {
            let sourceUid = get(savedGuestPermit(uid)).data.sourceUid;
            let source = get(ownerGatePath(sourceUid, worldId, rankId, gateId)).data;
            let previousMastery = before.get('masteryComplete', false);
            let nextMastery = after.get('masteryComplete', false);
            return (nextMastery == previousMastery ||
                (nextMastery == true && source.get('masteryComplete', false) == true)) &&
              sameImportedDate(before, after, source, 'loadedAt') &&
              sameImportedDate(before, after, source, 'readyAt') && sameImportedDate(before, after, source, 'clearedAt');
          }

          function sameImportedDate(before, after, source, field) {
            let value = after.get(field, null);
            return value == null || value == before.get(field, null) || value == source.get(field, null);
          }

          function stableLoadedAt(before, after) {
            let previous = before.get('loadedAt', null);
            let next = after.get('loadedAt', null);
            return next == previous || (previous == null && next == request.time);
          }
          allow read: if isOwner(uid);
          function unlockedGate() {
            let journey = getAfter(/databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)).data;
            return rankId in journey.unlockedRankIds && gateId in journey.unlockedGateIds;
          }
          allow create: if importingSavedGuest(uid) && validGateProgress(request.resource.data) && importedGateKeepsDates({}, request.resource.data);
          allow update: if importingSavedGuest(uid) && validGateProgress(request.resource.data) && importedGateKeepsDates(resource.data, request.resource.data);
          allow create: if isOwner(uid) && validGateProgress(request.resource.data) &&
            request.resource.data.get('masteryComplete', false) == false &&
            stableLoadedAt({}, request.resource.data) &&
            ((request.resource.data.status in ['available', 'learning'] && request.resource.data.readyEvidenceCount == 0 &&
              request.resource.data.get('activeClearAttemptId', '') == '' && unlockedGate()) || placementGate(request.resource.data));
          allow update: if isOwner(uid) && validGateProgress(request.resource.data) && validGateUpdate(resource.data, request.resource.data);
          allow delete: if false;

          match /lesson/legacyCredit {
            allow get: if isOwner(uid);
            allow write: if false;
          }

          match /lesson/progress {
            function idsWithin(values, parent) {
              return values is list && values.toSet().size() == values.size() && parent.hasAll(values);
            }

            function validStudy(data) {
              let study = data.study;
              let recalled = study.recalled.toSet();
              let recallAnswers = study.remembered.toSet().union(study.misses.keys().toSet());
              let missed = recalled.intersection(study.misses.keys().toSet());
              let completed = data.creditedIds.toSet().union(data.legacyCompletedIds.toSet())
                .union(recalled.intersection(study.remembered.toSet())).union(study.retried.toSet());
              return study.keys().hasOnly(['explained', 'details', 'taught', 'hinted', 'applied',
                  'remembered', 'recalled', 'reinforced', 'retried', 'applications', 'misses', 'retries']) &&
                idsWithin(study.explained, data.wordIds) && idsWithin(study.details, study.explained) &&
                idsWithin(study.taught, study.explained) && idsWithin(study.hinted, study.taught) &&
                study.applications is map && study.taught.hasAll(study.applications.keys()) &&
                study.applications.values().hasOnly(['correct', 'wrong', 'revealed', 'assisted']) &&
                idsWithin(study.applied, study.applications.keys()) &&
                idsWithin(study.remembered, study.applied) && study.misses is map &&
                study.applied.hasAll(study.misses.keys()) && study.misses.values().hasOnly(['wrong', 'revealed']) &&
                idsWithin(study.recalled, recallAnswers) && idsWithin(study.reinforced, missed) &&
                study.retries is map && missed.hasAll(study.retries.keys()) &&
                study.retries.values().hasOnly(['correct', 'wrong', 'revealed']) &&
                idsWithin(study.retried, study.retries.keys()) && data.completedWordIds.toSet() == completed;
            }

            function validLesson(data) {
              return data.keys().hasOnly(['version', 'wordIds', 'creditedIds', 'legacyCompletedIds', 'answers',
                  'passed', 'study', 'completedWordIds', 'updatedAt', '_savedGuestImportedAt']) &&
                data.version == 2 && data.wordIds is list && data.wordIds.size() > 0 &&
                data.wordIds.size() <= 2000 && data.wordIds.toSet().size() == data.wordIds.size() &&
                idsWithin(data.creditedIds, data.wordIds) && idsWithin(data.legacyCompletedIds, data.wordIds) &&
                idsWithin(data.completedWordIds, data.wordIds) &&
                data.answers is map && data.answers.size() <= data.wordIds.size() * 2 &&
                data.answers.values().hasOnly(['correct', 'wrong', 'revealed']) &&
                idsWithin(data.passed, data.answers.keys()) && validStudy(data) &&
                data.updatedAt == request.time && (!('_savedGuestImportedAt' in data) || importingSavedGuest(uid));
            }

            function historicalIds(checkpoint) {
              return checkpoint.get('version', 0) == 1
                ? checkpoint.get('completedWordIds', []).toSet().difference(checkpoint.get('creditedIds', []).toSet())
                : checkpoint.get('legacyCompletedIds', []).toSet();
            }

            function importedLessonIds(data, before) {
              let sourceUid = get(savedGuestPermit(uid)).data.sourceUid;
              let source = get(gateLessonPath(sourceUid, worldId, rankId, gateId)).data;
              return source.wordIds.toSet() == data.wordIds.toSet() &&
                historicalIds(before).union(historicalIds(source)).hasAll(data.legacyCompletedIds) &&
                before.get('creditedIds', []).toSet().union(source.creditedIds.toSet()).hasAll(data.creditedIds);
            }

            function grantedLegacyCredit(data, before) {
              let grantPath = /databases/$(database)/documents/users/$(uid)/contentProgress/$(worldId)/ranks/$(rankId)/gates/$(gateId)/lesson/legacyCredit;
              let grant = get(grantPath).data;
              return exists(gateLessonRelease()) && gateLessonCutoff() is timestamp &&
                grant.capturedAt is timestamp && grant.capturedAt < gateLessonCutoff() &&
                grant.wordIds.toSet() == data.wordIds.toSet() &&
                before.get('creditedIds', []).toSet().union(grant.creditedIds.toSet()).hasAll(data.creditedIds);
            }

            function keepsCompatibleCredit(data, before) {
              return historicalIds(before).hasAll(data.legacyCompletedIds) &&
                (before.get('creditedIds', []).hasAll(data.creditedIds) || grantedLegacyCredit(data, before));
            }

            function validCredit(data, before) {
              return keepsCompatibleCredit(data, before) || (importingSavedGuest(uid) && importedLessonIds(data, before));
            }

            function keepsStudy(data, before) {
              let old = before.get('study', {});
              let next = data.study;
              return next.explained.hasAll(old.get('explained', [])) && next.details.hasAll(old.get('details', [])) &&
                next.taught.hasAll(old.get('taught', [])) && next.hinted.hasAll(old.get('hinted', [])) &&
                next.applied.hasAll(old.get('applied', [])) && next.remembered.hasAll(old.get('remembered', [])) &&
                next.recalled.hasAll(old.get('recalled', [])) && next.reinforced.hasAll(old.get('reinforced', [])) &&
                next.retried.hasAll(old.get('retried', [])) &&
                next.applications.keys().hasAll(old.get('applications', {}).keys()) &&
                next.misses.keys().hasAll(old.get('misses', {}).keys()) &&
                next.retries.keys().hasAll(old.get('retries', {}).keys());
            }

            allow read: if isOwner(uid);
            allow create: if isOwner(uid) && validLesson(request.resource.data) &&
              get(gateContentPath(worldId, rankId, gateId)).data.publishedWordIds.toSet() == request.resource.data.wordIds.toSet() &&
              validCredit(request.resource.data, {});
            allow update: if isOwner(uid) && validLesson(request.resource.data) &&
              request.resource.data.wordIds == resource.data.wordIds &&
              validCredit(request.resource.data, resource.data) &&
              request.resource.data.creditedIds.hasAll(resource.data.creditedIds) &&
              request.resource.data.completedWordIds.hasAll(resource.data.completedWordIds) &&
              request.resource.data.passed.hasAll(resource.data.passed) &&
              request.resource.data.answers.keys().hasAll(resource.data.answers.keys()) &&
              keepsStudy(request.resource.data, resource.data);
          }

          match /readiness/proof {
            allow read: if isOwner(uid);
            allow create, update: if importingSavedGuest(uid) && request.resource.data.keys().hasOnly(['wordIds', 'addedWordId', '_savedGuestImportedAt']) &&
              request.resource.data.wordIds is list && request.resource.data.wordIds.size() <= 2000;
            allow create: if isOwner(uid) && validProofAppend(request.resource.data, [], uid, worldId, rankId, gateId);
            allow update: if isOwner(uid) && validProofAppend(request.resource.data, resource.data.wordIds, uid, worldId, rankId, gateId);
            allow delete: if false;
          }
        }
      }

      match /quizEvidenceSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if importingSavedGuest(uid) && request.resource.data.sessionId == sessionId && request.resource.data.status == 'completed';
        allow create: if isOwner(uid) && validEvidenceSession(request.resource.data, uid, sessionId);
        allow update, delete: if false;
      }
      match /contentOperations/{operationId} { allow read: if isOwner(uid); allow write: if false; }

      match /contentWords/{contentWordId} {
        function validContentWord(data) {
          return data.canonicalId == contentWordId && data.wordKey == contentWordId &&
            data.normalizationVersion == 1 && data.schemaVersion == 1 &&
            nonEmptyString(data.word, 240) && nonEmptyString(data.normalizedWord, 240) &&
            nonEmptyString(data.masteryKey, 240) &&
            (!('translation' in data) ||
              (data.translation is string && data.translation.size() <= 1000)) &&
            data.forgetCount is int && data.forgetCount >= 0 && data.forgetCount <= 100000 &&
            (!('sourceCount' in data) || (data.sourceCount is int && data.sourceCount >= 0)) &&
            (!('eligibleEvidenceCount' in data) ||
              (data.eligibleEvidenceCount is int && data.eligibleEvidenceCount >= 0 &&
                data.eligibleEvidenceCount <= 3));
        }
        allow read: if isOwner(uid);
        function evidenceFields() {
          return ['eligibleEvidenceCount', 'lastEligibleEvidenceAt', 'lastEvidenceEventId', 'evidenceVersion',
            'evidenceTimezoneOffsetMinutes', 'lastEvidenceLocalDayKey'];
        }
        allow create, update: if importingSavedGuest(uid) && validContentWord(request.resource.data);
        allow create: if isOwner(uid) && validContentWord(request.resource.data) &&
          request.resource.data.get('eligibleEvidenceCount', 0) == 0 &&
          request.resource.data.get('lastEligibleEvidenceAt', null) == null &&
          request.resource.data.get('lastEvidenceEventId', '') == '';
        allow update: if isOwner(uid) && validContentWord(request.resource.data) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(evidenceFields()) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(evidenceFields().concat(['updatedAt'])) &&
              validEvidenceProjection(resource.data, request.resource.data, uid, contentWordId)));
        allow delete: if false;
        match /sources/{sourceId} {
          function validSource(data) {
            return data.addedFrom in [
                'manual', 'dictionary-search', 'private-world', 'import',
                'published-gate', 'level-placement'
              ] && nonEmptyString(data.operationId, 180) &&
              data.linkedAt is timestamp &&
              (!('customWorldId' in data) || nonEmptyString(data.customWorldId, 500)) &&
              (!('importId' in data) || nonEmptyString(data.importId, 500));
          }
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validSource(request.resource.data);
          allow update: if false;
        }
        match /evidence/{eventId} {
          allow read: if isOwner(uid);
          allow create: if importingSavedGuest(uid) && request.resource.data.wordKey == contentWordId && request.resource.data.eventId == eventId;
          allow create: if isOwner(uid) && validEvidenceAnswer(request.resource.data, uid, contentWordId, eventId);
          allow update, delete: if false;
        }
      }
    }

    // Shared cache has intentionally public reads in production. Writes are
    // authenticated; only claim-based admins may remove entries.
    match /ai_global_cache/{cacheId} {
      function validCacheDocument(data) {
        return data.keys().hasOnly([
            'word', 'caches', 'type', 'meanings', 'meaning', 'createdAt'
          ]) &&
          nonEmptyString(data.word, 500) &&
          ('caches' in data || 'type' in data) &&
          (!('caches' in data) || data.caches is map) &&
          (!('type' in data) || data.type == 'normal' || data.type == 'gamer') &&
          (!('meanings' in data) || data.meanings is list) &&
          (!('meaning' in data) || data.meaning is string ||
            data.meaning is list || data.meaning is map);
      }

      allow read: if true;
      allow create: if hasPermanentAccount() && validCacheDocument(request.resource.data);
      allow update: if isAdmin() || (
        hasPermanentAccount() && validCacheDocument(request.resource.data) &&
        request.resource.data.word == resource.data.word
      );
      allow delete: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow create: if hasPermanentAccount() &&
        nonEmptyString(request.resource.data.word, 500) &&
        request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
