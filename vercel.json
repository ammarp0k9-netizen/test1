{
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/",
        "destination": "/landing.html"
      }
    ],
    "afterFiles": [
      {
        "source": "/app",
        "destination": "/index.html"
      },
      {
        "source": "/app/:path*",
        "destination": "/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/:path*",
        "destination": "/index.html"
      }
    ]
  }
}
